# ─────────────────────────────────────────────────────────────────────────────
# PORTFOLIO CMS & CLOUDINARY ENVIRONMENT VARIABLES
# ─────────────────────────────────────────────────────────────────────────────

# ─── 1. Cloudinary Storage (Signed Uploads & Assets) ───
# Format: cloudinary://<api_key>:<api_secret>@dbnyy6zmo
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@dbnyy6zmo

# (Optional: Individual Cloudinary Keys if not using CLOUDINARY_URL)
# CLOUDINARY_CLOUD_NAME=dbnyy6zmo
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Client Public Cloud Name (Exposed safely to Vite frontend)
VITE_CLOUDINARY_CLOUD_NAME=dbnyy6zmo
# VITE_CLOUDINARY_UPLOAD_PRESET=portfolio_preset

# ─── 2. Supabase (Database & Real-time State) ───
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
